# ============================================================
# docker compose's .env: which images to run
# ============================================================
#   cp .env.example .env
# thefeed's settings go in data/thefeed.env (configs/thefeed.env.example).
# ============================================================

# thefeed-server. The admin panel writes THEFEED_SERVER_TAG here when it
# updates or rolls back the server, so `docker compose up -d` keeps it.
THEFEED_SERVER_IMAGE=ghcr.io/sartoopjj/thefeed-server
THEFEED_SERVER_TAG=latest

# The admin panel. Update it with:
#   docker compose pull admin && docker compose up -d
THEFEED_ADMIN_IMAGE=ghcr.io/sartoopjj/thefeed-admin
THEFEED_ADMIN_TAG=latest
