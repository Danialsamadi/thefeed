# thefeed.env as the end-to-end suite leaves it before install.sh runs. With
# these set, every prompt has a default, so the installer runs with no answers.
# A throwaway domain and passphrase; DNS on 5300 since systemd-resolved holds 53.
# The suite adds THEFEED_ADMIN_RELEASE_BASE_URL, its fake release, and what
# its setup needs (THEFEED_ADMIN_DOCKER=0, or compose's THEFEED_LISTEN).
THEFEED_DOMAIN=t.e2e.test
THEFEED_KEY=e2e-throwaway-passphrase
THEFEED_LISTEN=127.0.0.1:5300
THEFEED_NO_TELEGRAM=1
TELEGRAM_API_ID=0
